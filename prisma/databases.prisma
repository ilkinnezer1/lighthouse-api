// Models: ManagedDatabase, DatabaseSnapshot.
// Enums: DatabaseType, DatabaseStatus, SnapshotStatus.

enum DatabaseType {
  POSTGRES
  MYSQL
  REDIS
  MONGO
}

enum DatabaseStatus {
  PROVISIONING
  READY
  FAILED
}

enum SnapshotStatus {
  PENDING
  READY
  FAILED
}

model ManagedDatabase {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  type    DatabaseType
  version String
  name    String
  status  DatabaseStatus @default(PROVISIONING)

  // True when Lighthouse provisioned a dedicated container for this row
  // (create-empty) and therefore owns its lifecycle. False for attach-existing
  // rows, which only reference another DB's connection — deleting them must
  // NOT tear down the shared container.
  ownsContainer Boolean @default(true) @map("owns_container")

  // Null until status flips to READY. Worker fills these in after the
  // container is reachable.
  host          String?
  port          Int?
  connSecretEnc String? @map("conn_secret_enc")
  errorSummary  String? @map("error_summary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  snapshots DatabaseSnapshot[]

  @@index([environmentId])
  @@map("managed_databases")
}

model DatabaseSnapshot {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  databaseId String          @map("database_id") @db.Uuid
  database   ManagedDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  status       SnapshotStatus @default(PENDING)
  storageKey   String?        @map("storage_key")
  sizeBytes    BigInt?        @map("size_bytes")
  errorSummary String?        @map("error_summary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([databaseId, createdAt(sort: Desc)])
  @@map("database_snapshots")
}
