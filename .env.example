# ---- runtime ----
NODE_ENV=development
PORT=3000

# ---- postgres ----
# Matches docker-compose.dev.yml defaults. Adjust user/password/host if you change those.
DATABASE_URL=postgresql://lighthouse:lighthouse_dev_pw@localhost:5432/lighthouse_dev?schema=public

# ---- redis ----
REDIS_URL=redis://localhost:6379

# ---- crypto ----
# 32-byte key, base64-encoded. Used for AES-256-GCM secret encryption.
# Generate one: openssl rand -base64 32
# Same key MUST be set on the Go worker — ciphertext written by Nest must decrypt in Go.
MASTER_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32

# ---- auth ----
# JWT signing secret (HMAC-SHA256). Must be at least 32 chars.
# Generate one: openssl rand -hex 64
JWT_SECRET=replace-with-openssl-rand-hex-64

# ---- bootstrap ----
# First-run seed: this email becomes the admin user on initial migration.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Password for the bootstrap admin. Min 12 chars. Change after first login.
BOOTSTRAP_ADMIN_PASSWORD=replace-me-min-12-chars

# ---- features ----
# When false, only existing users can sign in (no public signup).
ALLOW_PUBLIC_SIGNUP=true

# ---- routing ----
# local  -> http on *.localhost (dev, no TLS)
# server -> https on *.${BASE_DOMAIN} (Traefik + Let's Encrypt, prod)
MODE=local
# Apex used to build deploy URLs: <env>.<project>.<username>.${BASE_DOMAIN}
# Use "localhost" for dev. In server mode, set to your real apex (e.g. lighthouse.example.com).
BASE_DOMAIN=localhost

# ---- public URLs ----
# Public origin of this API and of the SPA. The GitHub OAuth callback is
# ${PUBLIC_API_URL}/integrations/github/callback; the SPA is where the callback
# redirects back to after connecting. Localhost defaults suit local dev.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173

# ---- github oauth (integrations) ----
# Credentials of a GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# The Authorization callback URL must be ${PUBLIC_API_URL}/integrations/github/callback.
# The client secret lives ONLY in the API env. Leave both unset to disable the
# GitHub integration (the connect endpoint then returns 503 "not configured").
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- atlassian oauth (jira issue titles on branch labels) ----
# An OAuth 2.0 (3LO) app from https://developer.atlassian.com/console/myapps/.
# Grant it the Jira scopes read:jira-work, read:jira-user, read:me and
# offline_access, and set the callback to
# ${PUBLIC_API_URL}/integrations/atlassian/callback.
# Leave both unset to disable the Jira integration — branches then render with
# their plain names and the connect endpoint returns 503 "not configured".
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=

# ---- object storage (MinIO) ----
# Snapshot blobs live here. Matches docker-compose.dev.yml defaults; in dev the
# access/secret keys are just the MinIO root user/password. Nest never speaks
# S3 — these creds are handed to the worker, which creates the bucket on first use.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=lighthouse
MINIO_SECRET_KEY=lighthouse_dev_pw
MINIO_BUCKET=snapshots
