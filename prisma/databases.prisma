// Models: ManagedDatabase, DatabaseSnapshot.
// Enums: DatabaseType, DatabaseStatus, SnapshotStatus.

enum DatabaseType {
  POSTGRES
  MYSQL
  REDIS
  MONGO
}

enum DatabaseStatus {
  PROVISIONING
  READY
  FAILED
}

enum SnapshotStatus {
  PENDING
  READY
  FAILED
}

model ManagedDatabase {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  type    DatabaseType
  version String
  name    String
  status  DatabaseStatus @default(PROVISIONING)

  // True when Lighthouse provisioned a dedicated container for this row
  // (create-empty) and therefore owns its lifecycle. False for attach-existing
  // rows, which only reference another DB's connection — deleting them must
  // NOT tear down the shared container.
  ownsContainer Boolean @default(true) @map("owns_container")

  // Mode 5 (create-empty + migrate): worker runs project.buildConfig.dbMigrate
  // once the container is healthy.
  runMigrate Boolean @default(false) @map("run_migrate")

  // Seed lineage for the create-from modes (7b). At most one is set, telling the
  // worker how to seed a freshly provisioned container:
  //   seedFromDatabaseId → mode 3 (copy):           pg_dump | pg_restore from a live DB
  //   seedFromSnapshotId → mode 4 (restore-to-new): pg_restore from a MinIO blob
  // SetNull so deleting the source/snapshot later just clears the pointer — the
  // seeded DB already holds its own copy of the data.
  seedFromDatabaseId String?           @map("seed_from_database_id") @db.Uuid
  seedFromDatabase   ManagedDatabase?  @relation("DatabaseSeed", fields: [seedFromDatabaseId], references: [id], onDelete: SetNull)
  seededDatabases    ManagedDatabase[] @relation("DatabaseSeed")

  seedFromSnapshotId String?           @map("seed_from_snapshot_id") @db.Uuid
  seedFromSnapshot   DatabaseSnapshot? @relation("SnapshotSeed", fields: [seedFromSnapshotId], references: [id], onDelete: SetNull)

  // Null until status flips to READY. Worker fills these in after the
  // container is reachable.
  host          String?
  port          Int?
  connSecretEnc String? @map("conn_secret_enc")
  errorSummary  String? @map("error_summary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  snapshots      DatabaseSnapshot[] @relation("DatabaseSnapshots")
  backupSchedule BackupSchedule?

  @@unique([environmentId, name])
  @@index([environmentId])
  @@map("managed_databases")
}

model DatabaseSnapshot {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  databaseId String          @map("database_id") @db.Uuid
  database   ManagedDatabase @relation("DatabaseSnapshots", fields: [databaseId], references: [id], onDelete: Cascade)

  status       SnapshotStatus @default(PENDING)
  storageKey   String?        @map("storage_key")
  sizeBytes    BigInt?        @map("size_bytes")
  errorSummary String?        @map("error_summary")

  // QA affordances: a human name, and the one snapshot an environment resets
  // back to. At most one baseline per database, enforced in the service.
  label      String?
  isBaseline Boolean @default(false) @map("is_baseline")

  // Set only by a BackupSchedule. Retention prunes automatic snapshots and
  // nothing else: a snapshot a person took deliberately is theirs to delete.
  automatic Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // New DBs provisioned by restoring this snapshot (mode 4).
  seededDatabases ManagedDatabase[] @relation("SnapshotSeed")

  @@index([databaseId, createdAt(sort: Desc)])
  @@index([databaseId, isBaseline])
  @@map("database_snapshots")
}
