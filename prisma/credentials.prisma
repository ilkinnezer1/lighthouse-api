// Models: GitCredential. Enums: GitCredentialKind.

enum GitCredentialKind {
  SSH_KEY
  PAT
  GITHUB_APP_INSTALL
}

model GitCredential {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Non-null => an ORGANIZATION credential: shared by the whole org and the
  // only thing that authenticates that org's deploys. Null => personal, usable
  // only by the person who added it. The two never back each other.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Who added it — attribution, not ownership. Nullable with SetNull because an
  // org credential is company infrastructure that must outlive the admin who
  // added it: cascading here would delete every member's ability to deploy the
  // moment that person is removed, which is the exact failure org credentials
  // exist to prevent. The migration adds a CHECK that at least one of
  // organization_id / user_id is present, so a row can never belong to nobody.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  kind  GitCredentialKind
  label String? // "Personal laptop key"

  // AES-256-GCM ciphertext of the secret (PAT, private key bytes, or app install token)
  secretEnc   String  @map("secret_enc")
  fingerprint String? // public sha for display only

  // Captured from GitHub when the token is validated at creation: who it
  // authenticates as, and what it is allowed to do. Stored so listing
  // credentials costs no GitHub call and works while GitHub is down.
  //
  // `scopes` is empty both for a scopeless classic token and for a
  // fine-grained PAT, which sends no `x-oauth-scopes` header at all — so empty
  // means "unknown", never "no access" (see src/integrations/github-token.ts).
  login  String?
  scopes String[] @default([])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([organizationId])
  @@map("git_credentials")
}
