// Models: NotificationChannel, NotificationDelivery. Enums: NotificationKind,
// DeliveryStatus.
//
// Channels are org-scoped: a team wants "tell #deploys when anything here
// ships", not one config per project.
//
// NotificationDelivery exists because the outbox cannot be replayed. Its drain
// marks `drained_at` globally, so once an event is drained it is gone from the
// poller — a failed webhook POST would be lost forever. The delivery row is both
// the retry record and the dedupe key for the outbox's at-least-once redelivery.

enum NotificationKind {
  SLACK
  DISCORD
  WEBHOOK
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED // retryable; the sweeper picks these up
  DEAD // gave up after maxAttempts
}

model NotificationChannel {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String
  kind NotificationKind

  // AES-256-GCM JSON blob, same layout as every other secret in the platform.
  // A Slack/Discord webhook URL is a bearer credential — anyone holding it can
  // post as the integration — so it is never stored in plain text.
  configEnc String @map("config_enc")

  enabled Boolean @default(true)
  // Canonical event names this channel wants (see notifications.constants.ts).
  // Empty means every event the notifier knows about.
  events String[] @default([])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([orgId])
  @@map("notification_channels")
}

model NotificationDelivery {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId String              @map("channel_id") @db.Uuid
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // event_outbox.id as text. The outbox is at-least-once, so this pair is what
  // stops a redelivered event from posting the same message twice.
  eventId String @map("event_id")
  event   String

  status   DeliveryStatus @default(PENDING)
  attempts Int            @default(0)
  lastError String?       @map("last_error")
  // Set on failure with backoff; the sweeper only picks up rows that are due.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  @@unique([eventId, channelId])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

// Notification is the other half of the story: a channel shouts into a room,
// this addresses one person. Written by a second consumer of the same
// `event_outbox` the channels read, and only ever when a specific recipient can
// be resolved — an event nobody owns stays a channel concern.

model Notification {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Canonical event name (see notifications.constants.ts), shared with the
  // `events` a channel subscribes to so there is one vocabulary, not two.
  kind  String
  title String
  body  String?

  // Relative in-app path (`/deployments/<id>`), never absolute: the inbox is
  // rendered inside the SPA and an origin baked in here would rot.
  link String?

  // Flat, denormalised subject of the notification — ids plus the names they
  // had at write time, so the client renders a sentence without resolving
  // anything, and a renamed project doesn't rewrite history.
  context Json?

  // The outbox is at-least-once, so a redelivered event must find this row
  // already present and stop. Prefixed by source (`outbox:<id>`) so a future
  // non-outbox notification cannot collide with an event id.
  dedupeKey String @map("dedupe_key")

  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  // Turned into a partial index (WHERE read_at IS NULL) in the migration SQL —
  // the badge count is the only query that touches it.
  @@index([userId, readAt])
  @@map("notifications")
}
