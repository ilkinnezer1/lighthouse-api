// Models: User, UserIdentity. Enums: UserRole, IdentityProvider.

enum UserRole {
  USER
  ADMIN
}

enum IdentityProvider {
  PASSWORD
  GITHUB
  GOOGLE
  ATLASSIAN
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordHash    String?   @map("password_hash")
  // DNS-label-safe handle. Becomes the `<user>` segment of deploy URLs:
  // <env>.<project>.<username>.<base-domain>. Citext so signup collisions
  // are case-insensitive (alice / Alice cannot both exist).
  username        String    @unique @db.Citext
  displayName     String?   @map("display_name")
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities     UserIdentity[]
  gitCredentials GitCredential[]
  projects       Project[] // projects this user created (owner/namespace)
  auditLogs      AuditLog[]
  deployments    Deployment[]    // deployments this user triggered
  outboxEvents   EventOutbox[]   // events targeted at this user
  notifications  Notification[]  // in-app inbox addressed to this user

  reportedFindings Finding[] @relation("FindingsReported")
  resolvedFindings Finding[] @relation("FindingsResolved")

  backupSchedules BackupSchedule[]

  lockedEnvironments Environment[] // environments this user currently holds

  memberships         OrgMembership[]
  sentInvitations     OrgInvitation[] @relation("OrgInvitationsSent")
  receivedInvitations OrgInvitation[] @relation("OrgInvitationsReceived")

  @@map("users")
}

model UserIdentity {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       IdentityProvider
  providerUserId String           @map("provider_user_id")
  providerEmail  String?          @map("provider_email")

  // OAuth tokens encrypted at rest with MASTER_ENCRYPTION_KEY (AES-256-GCM).
  accessTokenEnc  String?   @map("access_token_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamptz(3)
  scopes          String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identities")
}
