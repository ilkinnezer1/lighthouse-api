// Models: Project, Environment. Enums: EnvironmentType.

enum EnvironmentType {
  PRODUCTION
  PREVIEW
  MANUAL
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Authz anchor: a project belongs to an org; the caller's OrgMembership role
  // in this org decides what they can do (see src/common/authz.ts).
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  // The creator, kept for attribution AND as the per-user namespace anchor:
  // their username is the `<user>` segment of deploy URLs and whose GitHub
  // token deploys/branch lookups use. `owner` is the historical relation name
  // (== creator); the wire shape `project.owner.username` is unchanged.
  createdByUserId String @map("created_by_user_id") @db.Uuid
  owner           User   @relation(fields: [createdByUserId], references: [id])

  name          String
  slug          String // url-safe, lowercased
  subdomain     String // per-user namespace
  repoUrl       String @map("repo_url")
  defaultBranch String @default("main") @map("default_branch")

  providerRepoFullName String? @map("provider_repo_full_name")
  webhookSecretEnc     String? @map("webhook_secret_enc")

  // Validated by src/projects/dto/build-config.schema.ts.
  buildConfig Json @default("{}") @map("build_config")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  environments Environment[]

  @@unique([createdByUserId, slug])
  @@unique([createdByUserId, subdomain])
  @@index([organizationId])
  @@index([createdByUserId])
  @@index([providerRepoFullName])
  @@map("projects")
}

model Environment {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String // 'production', 'preview-pr-42'
  type         EnvironmentType
  branch       String? // nullable for type=MANUAL
  subdomain    String // usually = name
  // Unique so two environments can't claim the same host: Traefik would get two
  // routers with an identical Host rule and pick between them arbitrarily.
  // Nullable, and Postgres allows many NULLs, so unset environments are fine.
  customDomain String?         @unique @map("custom_domain")
  prNumber     Int?            @map("pr_number")

  // AES-256-GCM ciphertext of a single JSON blob: { "KEY": "value", ... }
  envVarsEnc String? @map("env_vars_enc")
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deployments      Deployment[]
  managedDatabases ManagedDatabase[]
  managedFiles     ManagedFile[]
  scheduledTasks   ScheduledTask[]
  volumeBackups    VolumeBackup[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("environments")
}

// Per-environment file overlays (e.g. `.env.local`) the worker writes into the
// clone at deploy time. `contentEnc` is AES-256-GCM ciphertext of the plaintext
// file body, sharing the worker-compatible MASTER_ENCRYPTION_KEY.
model ManagedFile {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  path       String
  contentEnc String @map("content_enc")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([environmentId, path])
  @@map("managed_files")
}

// A tar of one persistent volume, stored in MinIO. Volumes are the only place
// user data lives that no other backup covers: managed-database snapshots are
// Postgres-only, and teardown deletes an environment's volumes outright.
model VolumeBackup {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  // The logical name from buildConfig.volumes[].name, not the Docker volume.
  // Keying on it means a backup still restores after the volume is recreated.
  volumeName String @map("volume_name")

  // Reuses SnapshotStatus: PENDING while the worker tars and uploads, then
  // READY or FAILED. Same lifecycle as a database snapshot.
  status       SnapshotStatus @default(PENDING)
  storageKey   String?        @map("storage_key")
  sizeBytes    BigInt?        @map("size_bytes")
  errorSummary String?        @map("error_summary")
  label        String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([environmentId, createdAt(sort: Desc)])
  @@map("volume_backups")
}
