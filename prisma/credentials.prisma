// Models: GitCredential. Enums: GitCredentialKind.

enum GitCredentialKind {
  SSH_KEY
  PAT
  GITHUB_APP_INSTALL
}

model GitCredential {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  GitCredentialKind
  label String? // "Personal laptop key"

  // AES-256-GCM ciphertext of the secret (PAT, private key bytes, or app install token)
  secretEnc   String  @map("secret_enc")
  fingerprint String? // public sha for display only

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("git_credentials")
}
