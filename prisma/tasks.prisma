// Models: ScheduledTask, TaskRun. Enums: TaskOverlapPolicy, TaskRunStatus, TaskRunTrigger.
//
// A scheduled task is one command, in one service, on a cron. Multi-step work
// belongs in a script in the user's repo (`bash scripts/nightly.sh`) — the repo
// is the playbook, so there is deliberately no step/DAG model here.

enum TaskOverlapPolicy {
  SKIP // don't start if the previous run is still going
  QUEUE // run anyway
}

enum TaskRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED // overlap policy suppressed this run
}

enum TaskRunTrigger {
  SCHEDULE
  MANUAL
}

model ScheduledTask {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId String      @map("environment_id") @db.Uuid
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  name    String
  service String // compose service to exec in, e.g. "web"
  command String // full command, interpreter included: `bash scripts/nightly.sh`

  schedule String // 5-field cron expression
  timezone String @default("UTC")

  enabled    Boolean           @default(true)
  timeoutSec Int               @default(900) @map("timeout_sec")
  overlap    TaskOverlapPolicy @default(SKIP)

  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(3)
  // Precomputed so the every-minute sweep is an indexed lookup rather than
  // parsing every cron expression in the table on each tick.
  nextRunAt DateTime? @map("next_run_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs TaskRun[]

  @@unique([environmentId, name])
  @@index([enabled, nextRunAt])
  @@map("scheduled_tasks")
}

model TaskRun {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId String        @map("task_id") @db.Uuid
  task   ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Which deployment it actually ran against; null when nothing was live.
  deploymentId String? @map("deployment_id") @db.Uuid

  status   TaskRunStatus
  trigger  TaskRunTrigger @default(SCHEDULE)
  exitCode Int?           @map("exit_code")

  // Truncated tail of merged stdout/stderr — a task on `* * * * *` produces
  // 1440 runs a day, so full output is never retained.
  output       String?
  errorSummary String? @map("error_summary")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([taskId, startedAt(sort: Desc)])
  @@map("task_runs")
}
